<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the player can be started over adb with the diagnostics extras
     (apps/android/tools/spike-*.ps1). Release builds keep it private, so another app cannot
     start playback of an arbitrary URL under the signed-in account. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name=".player.PlayerActivity"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
