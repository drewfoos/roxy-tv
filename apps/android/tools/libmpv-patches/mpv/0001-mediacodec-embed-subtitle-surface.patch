+// The surface hands out a few buffers in turn, each still holding what was drawn
+// to it some frames ago. Each is told apart by its memory and brought up to date
+// from what changed since it was drawn last: copying less matters, an animated
+// line is redrawn for every frame.
+#define LAYER_SLOTS 8
+#define LAYER_RECTS 24
+
+struct layer_slot {
+    void *bits;                 // NULL: free
+    int w, h;
+    bool all;                   // nothing of it is known to be current
+    int num;                    // changed since it was drawn last:
+    struct mp_rect rc[LAYER_RECTS];
+};
+
 struct priv {
     struct mp_image *next_image;
     struct mp_hwdec_ctx hwctx;
+
+    // mpv's own subtitles on a second surface laid over the video's
+    // (--android-osd-wid). The decoder fills the video's surface itself, so
+    // nothing can be drawn there; without this the VO shows no subtitles.
+    int64_t osd_wid;            // the surface in use (0: none)
+    ANativeWindow *osd_window;
+    int osd_w, osd_h;
+    struct mp_draw_sub_cache *osd_cache;
+    double osd_pts;             // of the last frame shown: what a redraw draws
+    bool osd_all;               // every buffer has to be drawn whole
+    struct layer_slot osd_slots[LAYER_SLOTS];
+    int osd_next_slot;          // the one given up when a new buffer shows up
+    bool osd_locked;            // drawn; flip_page() shows it with the frame
+    bool osd_failed;            // the surface refused a drawing (said once)
 };
 
+// Shows what layer_draw() drew.
+static void layer_post(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (p->osd_locked)
+        ANativeWindow_unlockAndPost(p->osd_window);
+    p->osd_locked = false;
+}
+
+// Locks the surface's next buffer. All of it is asked for, so that the system
+// copies nothing into it from the buffer shown last: what it holds is what was
+// drawn to it before (see layer_slot).
+static bool layer_lock(struct vo *vo, ANativeWindow_Buffer *buf)
+{
+    struct priv *p = vo->priv;
+    ARect all = {0, 0, p->osd_w, p->osd_h};
+    if (ANativeWindow_lock(p->osd_window, buf, &all) < 0) {
+        mp_msg(vo->log, p->osd_failed ? MSGL_TRACE : MSGL_WARN,
+               "The subtitle surface cannot be drawn to.\n");
+        p->osd_failed = true;
+        return false;
+    }
+    p->osd_failed = false;
+    return true;
+}
+
+// The record of the buffer just locked; a buffer not seen before has to be drawn
+// whole.
+static struct layer_slot *layer_slot_of(struct vo *vo, ANativeWindow_Buffer *buf)
+{
+    struct priv *p = vo->priv;
+    for (int n = 0; n < LAYER_SLOTS; n++) {
+        struct layer_slot *slot = &p->osd_slots[n];
+        if (slot->bits == buf->bits && slot->w == buf->width && slot->h == buf->height)
+            return slot;
+    }
+    struct layer_slot *slot = &p->osd_slots[p->osd_next_slot];
+    MP_VERBOSE(vo, "Subtitle surface: buffer %d, %dx%d.\n", p->osd_next_slot,
+               buf->width, buf->height);
+    p->osd_next_slot = (p->osd_next_slot + 1) % LAYER_SLOTS;
+    *slot = (struct layer_slot){.bits = buf->bits, .w = buf->width,
+                                .h = buf->height, .all = true};
+    return slot;
+}
+
+// [rc] changed: every buffer has to draw it when its turn comes.
+static void layer_changed(struct priv *p, struct mp_rect rc)
+{
+    for (int n = 0; n < LAYER_SLOTS; n++) {
+        struct layer_slot *slot = &p->osd_slots[n];
+        if (!slot->bits || slot->all)
+            continue;
+        if (slot->num == LAYER_RECTS) {
+            // Too many to keep apart: one around them all.
+            for (int i = 1; i < slot->num; i++)
+                mp_rect_union(&slot->rc[0], &slot->rc[i]);
+            slot->num = 1;
+        }
+        slot->rc[slot->num++] = rc;
+    }
+}
+
+static uint32_t *layer_row(ANativeWindow_Buffer *buf, int x, int y)
+{
+    return (uint32_t *)((uint8_t *)buf->bits + (size_t)y * buf->stride * 4) + x;
+}
+
+// Makes the surface see-through again (the VO is going away).
+static void layer_clear(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!p->osd_window)
+        return;
+    layer_post(vo);
+    ANativeWindow_Buffer buf;
+    if (!layer_lock(vo, &buf))
+        return;
+    for (int y = 0; y < buf.height; y++)
+        memset(layer_row(&buf, 0, y), 0, (size_t)buf.width * 4);
+    ANativeWindow_unlockAndPost(p->osd_window);
+    p->osd_all = true;
+}
+
+static void layer_detach(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!p->osd_window)
+        return;
+    layer_post(vo);
+    ANativeWindow_release(p->osd_window);
+    p->osd_window = NULL;
+    p->osd_wid = 0;
+}
+
+// [wid]: a jobject of an android.view.Surface, or 0 for none. The caller keeps
+// it valid until it has set another.
+static void layer_attach(struct vo *vo, int64_t wid)
+{
+    struct priv *p = vo->priv;
+    if (wid == -1)
+        wid = 0;
+    if (wid == p->osd_wid)
+        return;
+    layer_detach(vo);
+    if (!wid)
+        return;
+
+    JNIEnv *env = MP_JNI_GET_ENV(vo);
+    ANativeWindow *window =
+        env ? ANativeWindow_fromSurface(env, (jobject)(intptr_t)wid) : NULL;
+    if (!window) {
+        MP_ERR(vo, "The subtitle surface cannot be used.\n");
+        return;
+    }
+    int w = ANativeWindow_getWidth(window), h = ANativeWindow_getHeight(window);
+    if (w <= 0 || h <= 0 || ANativeWindow_setBuffersGeometry(
+            window, w, h, WINDOW_FORMAT_RGBA_8888) < 0)
+    {
+        MP_ERR(vo, "The subtitle surface has no usable size (%dx%d).\n", w, h);
+        ANativeWindow_release(window);
+        return;
+    }
+    MP_VERBOSE(vo, "Subtitles on their own surface, %dx%d.\n", w, h);
+    p->osd_window = window;
+    p->osd_wid = wid;
+    p->osd_w = w;
+    p->osd_h = h;
+    p->osd_all = true;
+    p->osd_failed = false;
+    vo->want_redraw = true;
+}
+
+// Draws the subtitles of [osd_pts] into the surface's next buffer, if they are
+// not the ones it shows already. layer_post() shows them.
+static void layer_draw(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!p->osd_window || p->osd_locked)
+        return;
+
+    struct mp_osd_res res = {.w = p->osd_w, .h = p->osd_h, .display_par = 1.0};
+    struct sub_bitmap_list *sbs = osd_render(vo->osd, res, p->osd_pts,
+                                             OSD_DRAW_SUB_ONLY,
+                                             mp_draw_sub_formats);
+    if (!sbs)
+        return;
+
+    if (!p->osd_cache)
+        p->osd_cache = mp_draw_sub_alloc(p, vo->global);
+
+    struct mp_rect act[1], mod[64];
+    int num_act = 0, num_mod = 0;
+    // BGRA with premultiplied alpha, [osd_w] x [osd_h], see-through where
+    // there is nothing.
+    struct mp_image *osd = mp_draw_sub_overlay(p->osd_cache, sbs,
+                                               act, MP_ARRAY_SIZE(act), &num_act,
+                                               mod, MP_ARRAY_SIZE(mod), &num_mod);
+    if (!osd)
+        goto done;
+    if (p->osd_all) {
+        // A new surface, or one wiped: none of its buffers holds anything.
+        memset(p->osd_slots, 0, sizeof(p->osd_slots));
+    } else if (!num_mod) {
+        goto done; // the buffer on show is the overlay as it is
+    }
+    for (int n = 0; n < num_mod; n++)
+        layer_changed(p, mod[n]);
+
+    ANativeWindow_Buffer buf;
+    if (!layer_lock(vo, &buf))
+        goto done;
+    struct layer_slot *slot = layer_slot_of(vo, &buf);
+    if (slot->all) {
+        slot->rc[0] = (struct mp_rect){0, 0, buf.width, buf.height};
+        slot->num = 1;
+    }
+    int w = MPMIN(buf.width, osd->w), h = MPMIN(buf.height, osd->h);
+    for (int n = 0; n < slot->num; n++) {
+        struct mp_rect rc = slot->rc[n];
+        int x0 = MPCLAMP(rc.x0, 0, w), x1 = MPCLAMP(rc.x1, 0, w);
+        for (int y = MPCLAMP(rc.y0, 0, buf.height); y < MPCLAMP(rc.y1, 0, buf.height); y++) {
+            uint32_t *dst = layer_row(&buf, 0, y);
+            if (slot->all) // also what lies outside the overlay, if anything does
+                memset(dst, 0, (size_t)buf.width * 4);
+            if (y >= h)
+                continue;
+            const uint32_t *src = mp_image_pixel_ptr(osd, 0, 0, y);
+            // The surface's bytes are R G B A, the overlay's B G R A.
+            for (int x = x0; x < x1; x++) {
+                uint32_t v = src[x];
+                dst[x] = (v & 0xFF00FF00u) | ((v & 0xFFu) << 16) | ((v >> 16) & 0xFFu);
+            }
+        }
+    }
+    slot->all = false;
+    slot->num = 0;
+    p->osd_locked = true;
+    p->osd_all = false;
+
+done:
+    talloc_free(sbs);
+}
